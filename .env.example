# ---------- 필수 (배포 시) ----------
# 저장소: Upstash Redis (Vercel에서는 꼭 필요. 없으면 시연용 메모리 저장소라 기록이 사라짐)
# 평가위원 섭외 시스템과 같은 Upstash를 써도 됩니다 (키 앞에 kmc: 가 붙어 섞이지 않음)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 로그인 세션 서명용 긴 임의 문자열
SESSION_SECRET=
# 실 관리(실 만들기·비밀번호) 화면 비밀번호
ADMIN_PASSWORD=
# 체험용 실(가상 데이터)을 숨기려면 1
DEMO_DISABLED=

# ---------- 수집 메일함 (선택) ----------
# 두레이 필터로 대상 메일을 이 메일함(실별 폴더)으로 자동 전달해 두면 [새 메일 가져오기]로 읽어 옵니다.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ---------- 메일 발송 (선택) ----------
# 예: 네이버 smtp.naver.com / 465 / 앱 비밀번호
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=KIAT 국제협력전략실
# 받는 사람이 '회신'하면 갈 주소 (담당자 두레이 메일 등)
EMAIL_REPLY_TO=
# 실제로 보낼 수 있는 받는 주소. 쉼표로 구분, '@도메인' 가능, '*'는 모두 허용(기관 승인 후)
EMAIL_ALLOWED_RECIPIENTS=

# ---------- AI (선택) ----------
# 시제품: Claude API
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# 기관 내부 이관: OpenAI 호환 내부 모델 서버
# AI_PROVIDER=internal
# AI_BASE_URL=http://내부모델서버:8000/v1
# AI_MODEL=모델명
# AI_API_KEY=
