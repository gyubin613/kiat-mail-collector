# 모두 선택 사항입니다. 아무것도 없으면 규칙 기반으로만 분류합니다.

# 시제품: Claude API
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5

# 기관 내부 이관: OpenAI 호환 내부 모델 서버
# AI_PROVIDER=internal
# AI_BASE_URL=http://내부모델서버:8000/v1
# AI_MODEL=모델명
# AI_API_KEY=

# 외부 배포 시 AI 호출 잠금
APP_PASSWORD=

# 독촉 메일 발송 (SMTP). 예: 네이버 smtp.naver.com / 465 / 앱 비밀번호
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=KIAT 국제협력전략실
# 받는 사람이 '회신'하면 갈 주소 (담당자 두레이 메일 등)
EMAIL_REPLY_TO=
# 실제로 보낼 수 있는 받는 주소. 쉼표로 구분, '@도메인' 가능, '*'는 모두 허용(기관 승인 후)
# 시제품 시연 때는 내 주소만 넣고 '나에게 시험 발송'으로 확인하세요.
EMAIL_ALLOWED_RECIPIENTS=
